# DIY ESP32-S3 N16R8 CAM board (e.g. GOOUUU ESP32-S3-CAM): ESP32-S3R8 (8 MB
# octal PSRAM), 16 MB flash, 1.54" 240x240 ST7789 SPI LCD, INMP441 I2S
# microphone, MAX98357A I2S amplifier, BOOT button as push-to-talk. No touch,
# no battery; USB-powered through the board's TTL (CH340) port.
# Load last, after sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_S3CAM_DIY=y

# The LCD uses GPIO19/20, the chip's native USB pins, so the console and the
# serial log go out the CH340 TTL port (UART0) instead of USB Serial/JTAG.
CONFIG_MUSE_CONSOLE_UART=y

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="DIO"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). Without it free
# internal RAM falls to 6 KB pieces and BLE setup can't start its 8 KB task.
# The chip always has PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Single-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y
# Verified against upstream main 2026-10-13; triggers the first CI build for this board.

# The LCD sits on the S3's USB pins (GPIO19/20). The IDF-default secondary
# USB Serial/JTAG console would claim those pins and mute the panel, so it
# must stay off for this board; the console is the CH340 UART0 above.
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
